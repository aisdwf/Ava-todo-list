<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlowTask.Desktop.ViewModels"
        xmlns:conv="using:FlowTask.Desktop.Converters"
        xmlns:controls="using:FlowTask.Desktop.Controls"
        x:Class="FlowTask.Desktop.Views.QuickCaptureWindow"
        x:DataType="vm:QuickCaptureViewModel"
        Title="FlowTask 快捷小窗"
        Icon="/Assets/Brand/flowtask-icon.ico"
        Width="420"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent, None"
        Background="Transparent">

    <!--
      不再用 Panel Margin 给投影留白，改为 Border 直接顶满窗口：
      TransparencyLevelHint 请求的透明合成在很多环境下协商失败
      （Windows 关闭透明特效/远程桌面/部分显卡驱动，macOS 上 Avalonia 对 Blur 系列材质支持也不稳定）。
      协商失败时 Avalonia/OS 会用不透明默认色填满整个窗口矩形；
      此前窗口比圆角胶囊大 14px（专门留给 BoxShadow），
      这圈留白一旦失去透明度就会在两个平台上都显形为方形纯色边框包住圆角胶囊。
      让窗口矩形与圆角胶囊本体重合可以消除这个方形边框；代价是舍弃投影效果。
    -->
    <Border CornerRadius="{DynamicResource FloatingCapsuleCornerRadius}"
            Background="{DynamicResource FloatingSurfaceBrush}"
            BorderBrush="{DynamicResource HairlineStrongBrush}"
            BorderThickness="1"
            ClipToBounds="True">

        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,18,20,14">

            <!-- 贯穿式主输入：无内框，靠字号建立焦点 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <Viewbox Grid.Column="0"
                         Width="16" Height="16"
                         VerticalAlignment="Center"
                         Margin="0,0,14,0">
                    <Path Classes="StrokeIcon Accent" Data="{StaticResource IconSpark}" />
                </Viewbox>

                <TextBox Grid.Column="1"
                         x:Name="InputBox"
                         Classes="EditorialInput"
                         Text="{Binding InputText, Mode=TwoWay}"
                         Watermark="Something to do..."
                         VerticalAlignment="Center" />
            </Grid>

            <!-- 项目下拉是小窗唯一的项目上下文 (spec-quick-window-single-project-list §7)：
                 同时决定下方列表与新建任务归属；Ctrl+Tab / Ctrl+Shift+Tab 循环切换 -->
            <ComboBox Grid.Row="1"
                      Margin="0,14,0,0"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:ProjectItemViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                            <Ellipse Grid.Column="0"
                                     Width="8" Height="8"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 单项目任务列表：查看 + 勾选，不打开主窗即可完成（R-1.1/R-1.2/R-1.4） -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="这个项目还没有任务"
                           Classes="CaptionText"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,12"
                           IsVisible="{Binding IsTaskListEmpty}" />

                <ScrollViewer x:Name="TaskListScroll"
                              MaxHeight="260"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding !IsTaskListEmpty}">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TaskRowViewModel">
                                <!-- Background 透明而非空：否则行的空白处不参与命中，:pointerover 不触发，悬停入口不会浮现 -->
                                <Border Classes="QuickTaskRow"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <CheckBox Grid.Column="0"
                                                  Classes="RingCheck"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Command="{Binding $parent[Window].((vm:QuickCaptureViewModel)DataContext).ToggleTaskCompleteCommand}"
                                                  CommandParameter="{Binding Task}" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Task.Title}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Classes.QuickCaptureCompleted="{Binding IsCompleted}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />

                                        <!-- 到期日 (R-1.10)：有值常驻显示、点击修改；无值时悬停整行浮现「到期」入口。
                                             首版形态，待 owner 预览裁决（spec-due-date-picker Q2）。 -->
                                        <controls:DueDatePicker Grid.Column="2"
                                                                Classes="HoverOnly"
                                                                Margin="8,0,0,0"
                                                                IsVisible="{Binding !IsCompleted}"
                                                                Date="{Binding DueDate}"
                                                                Editor="{Binding $parent[Window].((vm:QuickCaptureViewModel)DataContext).RowDueDateEditor}"
                                                                CommitCommand="{Binding $parent[Window].((vm:QuickCaptureViewModel)DataContext).CommitRowDueDateCommand}"
                                                                CommitTarget="{Binding}" />
                                        <TextBlock Grid.Column="2"
                                                   Classes="MetaText Done"
                                                   Margin="8,0,0,0"
                                                   IsVisible="{Binding IsCompleted}"
                                                   Text="{Binding CompletedLocalText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 底部：优先级分段选择 + 新任务到期日 + 快捷键指引 -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" Margin="0,14,0,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <RadioButton Classes="SegmentChoice" GroupName="CapturePriority" Content="P1"
                                 IsChecked="{Binding Priority, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=High, Mode=TwoWay}" />
                    <RadioButton Classes="SegmentChoice" GroupName="CapturePriority" Content="P2"
                                 IsChecked="{Binding Priority, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=Medium, Mode=TwoWay}" />
                    <RadioButton Classes="SegmentChoice" GroupName="CapturePriority" Content="P3"
                                 IsChecked="{Binding Priority, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=Low, Mode=TwoWay}" />
                </StackPanel>

                <!-- 新任务到期日：常驻可点击（用户裁决「绝对需要有直接点击的入口」），Ctrl+D 仅为补充 -->
                <controls:DueDatePicker Grid.Column="1"
                                        x:Name="NewDuePicker"
                                        Margin="10,0,0,0"
                                        Date="{Binding NewTaskDueDate}"
                                        Editor="{Binding NewDueDateEditor}"
                                        ToolTip.Tip="设置到期日（Ctrl+D）" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Spacing="8" VerticalAlignment="Center">
                    <Border Classes="KeyCap">
                        <TextBlock Text="Ctrl+Tab" />
                    </Border>
                    <TextBlock Text="切换项目" Classes="CaptionText" VerticalAlignment="Center" />

                    <Border Classes="KeyCap" Margin="6,0,0,0">
                        <TextBlock Text="↵" />
                    </Border>
                    <TextBlock Text="保存" Classes="CaptionText" VerticalAlignment="Center" />

                    <Border Classes="KeyCap" Margin="6,0,0,0">
                        <TextBlock Text="Esc" />
                    </Border>
                    <TextBlock Text="关闭" Classes="CaptionText" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
