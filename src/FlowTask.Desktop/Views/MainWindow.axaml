<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlowTask.Desktop.ViewModels"
        xmlns:models="using:FlowTask.Core.Models"
        xmlns:conv="using:FlowTask.Desktop.Converters"
        xmlns:appearance="using:FlowTask.Desktop.Appearance"
        xmlns:controls="using:FlowTask.Desktop.Controls"
        xmlns:onboarding="using:FlowTask.Desktop.Views.Onboarding"
        xmlns:guide="using:FlowTask.Desktop.Views.Guide"
        x:Class="FlowTask.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FlowTask"
        Icon="/Assets/Brand/flowtask-icon.ico"
        Width="1180" Height="780"
        MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome">

    <Grid>
        <Grid ColumnDefinitions="272,*"
              IsHitTestVisible="{Binding !IsBlockingOverlayOpen}">

            <!-- ==================== 左侧极简导航 (design-visual-language §2.2) ====================
                 无右侧分割线：Editorial 风格以底色差异而非描边划分区域。 -->
            <!-- 侧边栏使用极弱叠加色而非不透明底：透明材质档位下不透明面板会
                 遮盖平台合成的模糊效果，使材质切换在视觉上毫无差别 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarWashBrush}"
                    Padding="{DynamicResource SidebarPadding}">
                <Grid>
                <!-- 任务导航：设置页打开时让位给选项栏 -->
                <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding !IsSettingsOpen}">

                    <!-- 品牌区 -->
                    <StackPanel Grid.Row="0" Margin="14,28,0,40" Spacing="6">
                        <TextBlock Text="FLOWTASK"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   LetterSpacing="3"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="心流待办工作台"
                                   Classes="CaptionText" />
                    </StackPanel>

                    <!-- 视图导航。整块是引导「项目」步的锚点：零项目时只剩 VIEWS 与「新建项目」，仍要框得到入口 -->
                    <StackPanel Grid.Row="1" Spacing="2"
                                VerticalAlignment="Top"
                                onboarding:OnboardingAnchor.Key="{x:Static vm:OnboardingTargets.SidebarProjects}">
                        <TextBlock Text="VIEWS" Classes="MicroLabel" Margin="14,0,0,12" />

                        <!-- 侧边栏高亮统一表达 (spec-sidebar-selection-consolidation)：
                             VIEWS 三项与下方 PROJECTS 各行同为 Button + Command 触发、
                             Classes.Selected 驱动高亮，不再有 RadioButton.IsChecked
                             双向绑定这条独立回环路径。 -->
                        <Button Classes="NavPill"
                                Classes.Selected="{Binding IsActiveFilterSelected}"
                                Command="{Binding ChangeFilterCommand}"
                                CommandParameter="{x:Static vm:TaskFilter.Active}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="全部任务" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="CountBadge">
                                    <TextBlock Text="{Binding ActiveCount}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- ========== PROJECTS 区块 (spec-classification-ui / design-domain-contract §5.1) ==========
                             整块随 HasProjects 显隐：零项目时不显示空列表、不显示占位，
                             使从不使用项目的用户获得与改动前完全一致的侧边栏（§3.3）。
                             新建入口另置于底部，不在此区块内，故零项目时此处彻底消失。 -->
                        <StackPanel Spacing="2" Margin="0,28,0,0" IsVisible="{Binding HasProjects}">
                            <TextBlock Text="PROJECTS" Classes="MicroLabel" Margin="14,0,0,12" />

                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ProjectItemViewModel">
                                        <Border Classes="ProjectRow"
                                                Classes.Selected="{Binding IsSelected}"
                                                DoubleTapped="OnProjectRowDoubleTapped"
                                                Tapped="OnProjectRowTapped">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                                <Ellipse Grid.Column="0"
                                                         Classes="ProjectDot"
                                                         Margin="0,0,10,0"
                                                         Fill="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />

                                                <!-- 常态：项目名，双击进入重命名 -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsRenaming}" />

                                                <!-- 编辑态：原地重命名输入框 -->
                                                <TextBox Grid.Column="1"
                                                         Classes="FieldInput"
                                                         Text="{Binding RenameBuffer, Mode=TwoWay}"
                                                         IsVisible="{Binding IsRenaming}"
                                                         VerticalAlignment="Center"
                                                         LostFocus="OnProjectRenameLostFocus">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter"
                                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CommitRenameProjectCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        <KeyBinding Gesture="Escape"
                                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelRenameProjectCommand}"
                                                                    CommandParameter="{Binding}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>

                                                <!-- 计数：重命名时让位给输入框 -->
                                                <Border Grid.Column="2" Classes="CountBadge"
                                                        IsVisible="{Binding !IsRenaming}">
                                                    <TextBlock Text="{Binding TaskCount}" />
                                                </Border>

                                                <!-- 删除槽位对所有行固定占位：Default 无删除入口，若整列折叠，
                                                     其计数会比其它行右移一个按钮宽，上下不对齐。
                                                     故 Default 行放一个等宽空占位，而不是隐藏整列。 -->
                                                <Border Grid.Column="3"
                                                        Width="22"
                                                        Margin="4,0,0,0"
                                                        IsVisible="{Binding !ShowDeleteAction}" />
                                                <Button Grid.Column="3"
                                                        Classes="ProjectAction"
                                                        Margin="4,0,0,0"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestDeleteProjectCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsVisible="{Binding ShowDeleteAction}"
                                                        ToolTip.Tip="删除项目（其下任务一并删除）">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Classes="StrokeIcon Muted" Data="{StaticResource IconTrash}" />
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 新建项目入口：渐进披露 —— 默认仅一个「＋」，点击才展开输入 -->
                        <Button Classes="ProjectAddTrigger"
                                Margin="0,10,0,0"
                                Command="{Binding ToggleCreateProjectCommand}"
                                IsVisible="{Binding !IsCreatingProject}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                    <Path Classes="StrokeIcon Muted" Data="{StaticResource IconPlus}" />
                                </Viewbox>
                                <TextBlock Text="新建项目" FontSize="13"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel x:Name="NewProjectEditor"
                                    IsVisible="{Binding IsCreatingProject}">
                            <TextBox Classes="FieldInput"
                                     x:Name="NewProjectInput"
                                     Margin="14,10,4,0"
                                     Watermark="项目名称"
                                     Text="{Binding NewProjectName, Mode=TwoWay}"
                                     LostFocus="OnNewProjectLostFocus">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CreateProjectCommand}" />
                                    <KeyBinding Gesture="Escape" Command="{Binding ToggleCreateProjectCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <TextBlock Classes="CaptionText"
                                       Margin="14,4,4,0"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasCreateProjectError}"
                                       Text="{Binding CreateProjectError}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 底部快捷小窗唤起钮 (design-visual-language §2.2)：
                         spec-quick-window-single-project-list 后小窗已不只是输入胶囊，
                         而是独立的查看+勾选+捕捉小窗，文案与副标题同步更新，不再称「随手记」 -->
                    <Button Grid.Row="2"
                            Classes="CaptureTrigger"
                            onboarding:OnboardingAnchor.Key="{x:Static vm:OnboardingTargets.CaptureTrigger}"
                            Command="{Binding OpenQuickCaptureCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="快捷小窗" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="查看待办、勾选、随手记一件事" Classes="CaptionText" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="KeyCap">
                                <TextBlock Text="{Binding QuickCaptureHotkeyLabel}" />
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <!-- 设置选项栏：占满原左侧栏，最顶部为返回 (spec-settings-master-detail-and-theme-presets) -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSettingsOpen}">
                    <Button Classes="NavPill"
                            Margin="0,8,0,10"
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip.Tip="返回任务清单">
                        <StackPanel Spacing="3">
                            <TextBlock Text="← 返回" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="回到任务清单" Classes="CaptionText" />
                        </StackPanel>
                    </Button>
                    <ListBox Grid.Row="1"
                             Classes="SettingsNav"
                             ItemsSource="{Binding SettingsNavItems}"
                             SelectedItem="{Binding SelectedSettingsNavItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:SettingsNavItem">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Classes="CaptionText" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                </Grid>
            </Border>

            <!-- ==================== 右侧 Hero 级内容区 ==================== -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="{DynamicResource ContentAreaMargin}">

                <!-- 顶部：Hero 标题 + 右上角交互区 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,24,0,36">

                    <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding !IsSettingsOpen}">
                        <TextBlock Text="{Binding CurrentCategorySubtitle}"
                                   Classes="MicroLabel"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding CurrentCategoryTitle}"
                                   Classes="HeroTitle" />
                    </StackPanel>

                    <!-- 设置页头：标题随当前选项变化，与下方内容区同一项 -->
                    <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding IsSettingsOpen}">
                        <TextBlock Text="{Binding SelectedSettingsNavItem.DisplayName}"
                                   Classes="HeroTitle" />
                        <TextBlock Classes="CaptionText"
                                   Text="主题会更换底色、文本、边框和强调色；材质即时生效。"
                                   IsVisible="{Binding SelectedSettingsSection, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=Appearance}" />
                        <TextBlock Classes="CaptionText"
                                   Text="与功能相关的设置。目前可改「启用默认到期」的天数。"
                                   IsVisible="{Binding SelectedSettingsSection, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=General}" />
                        <TextBlock Classes="CaptionText"
                                   Text="每个功能配一段动图演示；也可以重新播放新手引导。"
                                   IsVisible="{Binding SelectedSettingsSection, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=Guide}" />
                        <TextBlock Classes="CaptionText"
                                   Text="版本与技术信息。"
                                   IsVisible="{Binding SelectedSettingsSection, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=About}" />
                    </StackPanel>

                    <!-- 右上角按钮组：「? | 齿轮 | 昼夜」。会随设置页消失的两个放左侧，
                         昼夜锚定最右，打开设置后不滑位（spec-settings-theme-button-order 同一原则）。 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                onboarding:OnboardingAnchor.Key="{x:Static vm:OnboardingTargets.HeaderActions}">
                        <!-- 操作指南入口（spec-onboarding-guide，R-6.3）：常驻可见，不藏在齿轮里 -->
                        <Button Classes="IconCircle"
                                Command="{Binding OpenGuideCommand}"
                                ToolTip.Tip="操作指南"
                                AutomationProperties.Name="操作指南"
                                IsVisible="{Binding !IsSettingsOpen}">
                            <Viewbox Width="18" Height="18">
                                <Path Classes="StrokeIcon" Data="{StaticResource IconHelp}" />
                            </Viewbox>
                        </Button>

                        <!-- 设置页返回在左侧栏顶部，齿轮此时隐藏避免入口冗余。
                             tooltip 原为「外观设置」，设置页早已不止外观（spec-onboarding-guide Q4）。 -->
                        <Button Classes="IconCircle"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip.Tip="设置"
                                AutomationProperties.Name="设置"
                                IsVisible="{Binding !IsSettingsOpen}">
                            <Viewbox Width="18" Height="18">
                                <Path Classes="StrokeIcon" Data="{StaticResource IconSettings}" />
                            </Viewbox>
                        </Button>

                        <Button x:Name="ThemeToggleButton"
                                Classes="IconCircle"
                                ToolTip.Tip="切换昼夜主题"
                                AutomationProperties.Name="切换昼夜主题">
                            <!-- 深色时显示太阳（提示可切亮），浅色时显示月亮；二者同一描边 -->
                            <Panel>
                                <Viewbox Width="18" Height="18" IsVisible="{Binding IsDarkTheme}">
                                    <Path Classes="StrokeIcon" Data="{StaticResource IconSun}" />
                                </Viewbox>
                                <Viewbox Width="18" Height="18" IsVisible="{Binding !IsDarkTheme}">
                                    <Path Classes="StrokeIcon" Data="{StaticResource IconMoon}" />
                                </Viewbox>
                            </Panel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ==================== 主体：任务流 / 外观设置 ==================== -->
                <Grid Grid.Row="1">

                    <!-- ========== 视图 A: Editorial 任务流 ========== -->
                    <!-- Row 0 添加栏 / Row 1 任务流（删除项目确认已改为居中弹层，不再插入一行推动列表） -->
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsSettingsOpen}">

                        <!-- 贯穿式添加栏 (design-visual-language §2.3)：无边框，仅底部发丝线 -->
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource HairlineStrongBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="4,0,4,16"
                                Margin="0,0,0,8"
                                onboarding:OnboardingAnchor.Key="{x:Static vm:OnboardingTargets.AddBar}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0"
                                         x:Name="NewTaskInput"
                                         onboarding:OnboardingAnchor.Key="{x:Static vm:OnboardingTargets.AddInput}"
                                         Classes="EditorialInput"
                                         Text="{Binding NewTaskTitle, Mode=TwoWay}"
                                         Watermark="记录下一件重要的事…"
                                         VerticalAlignment="Center">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>

                                <!-- 到期日：唯一入口，浮层叠加不推动布局 (spec-due-date-picker)。
                                     与优先级同处一行，默认态为「到期」占位，新建不自动写入日期。 -->
                                <controls:DueDatePicker Grid.Column="1"
                                                        Margin="12,0,12,0"
                                                        VerticalAlignment="Center"
                                                        PopupPlacement="BottomEdgeAlignedRight"
                                                        Date="{Binding NewTaskDueDate}"
                                                        Editor="{Binding NewDueDateEditor}" />

                                <!-- 优先级分段直选，替代原下拉框 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <RadioButton Classes="SegmentChoice" GroupName="NewPriority" Content="P1"
                                                 IsChecked="{Binding NewTaskPriority, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=High, Mode=TwoWay}" />
                                    <RadioButton Classes="SegmentChoice" GroupName="NewPriority" Content="P2"
                                                 IsChecked="{Binding NewTaskPriority, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=Medium, Mode=TwoWay}" />
                                    <RadioButton Classes="SegmentChoice" GroupName="NewPriority" Content="P3"
                                                 IsChecked="{Binding NewTaskPriority, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=Low, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 空状态 -->
                        <StackPanel Grid.Row="1"
                                    Spacing="10"
                                    Margin="4,72,0,0"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    onboarding:OnboardingAnchor.Key="{x:Static vm:OnboardingTargets.TaskEmpty}"
                                    IsVisible="{Binding IsTaskStreamEmpty}">
                            <TextBlock Text="NOTHING HERE" Classes="MicroLabel" />
                            <TextBlock Text="这片空白等待被填满"
                                       Classes="SectionTitle"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="在上方输入框写下第一件事，按回车即可。"
                                       Classes="BodyText"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>

                        <!-- 呼吸感条目流：无卡片描边，靠留白与发丝线建立节奏。
                             底部/右侧留白必须写在内部内容的 Margin，不能写 ScrollViewer.Padding：
                             Avalonia 11.2 ScrollContentPresenter 计算 Extent 时只计入子元素
                             尺寸与 Margin，不计自身 Padding，否则滚到底时最后一行会被裁掉约半行。 -->
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding !IsTaskStreamEmpty}">
                            <ItemsControl ItemsSource="{Binding Tasks}"
                                          Margin="0,0,12,32">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TaskRowViewModel">
                                        <!-- 每行都带锚点：引导取可视树里第一个，即列表首行 -->
                                        <Border Classes="TaskRow"
                                                onboarding:OnboardingAnchor.Key="{x:Static vm:OnboardingTargets.TaskRow}"
                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="{DynamicResource TaskRowPadding}">
                                            <!-- 双行布局 (spec-due-date-picker §C)：
                                                 第 1 行 勾选 | 色条 | 优先级 | 标题 | 删除；
                                                 第 2 行 元信息（项目 · 到期 · 创建），与标题左对齐。
                                                 此前 7 列单行把到期与创建日期挤在最右，中间只有一行标题的空白。 -->
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                                  RowDefinitions="Auto,Auto">

                                                <CheckBox Grid.Column="0" Grid.Row="0"
                                                          Classes="RingCheck"
                                                          IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,18,0"
                                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleCompleteCommand}"
                                                          CommandParameter="{Binding Task}" />

                                                <!-- 项目色条：跨两行，贯穿标题与元信息 (design-domain-contract §5.2)。
                                                     无项目时整体不渲染，行布局与改动前一致 -->
                                                <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                                        Classes="ProjectStripe"
                                                        IsVisible="{Binding HasProject}"
                                                        Background="{Binding ProjectColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                                        ToolTip.Tip="{Binding ProjectName}" />

                                                <!-- 优先级：P 标签即入口，点击弹出贴边浮层点选即生效 (spec-inline-task-edit)。
                                                     配色仍由 PriorityTag.P1–P3 样式类表达 (spec-editorial-and-ripple-theme §2)。 -->
                                                <controls:PriorityPicker Grid.Column="2" Grid.Row="0"
                                                                         Margin="0,0,16,0"
                                                                         VerticalAlignment="Center"
                                                                         Priority="{Binding Priority}"
                                                                         CommitCommand="{Binding $parent[Window].((vm:MainViewModel)DataContext).CommitRowPriorityCommand}"
                                                                         CommitTarget="{Binding}" />

                                                <!-- 大字号标题：Editorial 气势的主要载体。双击就地改名 (spec-inline-task-edit)：
                                                     Enter / 点击外部保存，Esc 取消。Background 透明使整格可命中双击。 -->
                                                <Panel Grid.Column="3" Grid.Row="0"
                                                       Background="Transparent"
                                                       ToolTip.Tip="双击修改标题"
                                                       DoubleTapped="OnTaskTitleDoubleTapped">
                                                    <TextBlock Classes="TaskTitle"
                                                               Classes.Completed="{Binding IsCompleted}"
                                                               Text="{Binding Title}"
                                                               IsVisible="{Binding !IsEditingTitle}"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Classes="TitleInput"
                                                             Text="{Binding TitleBuffer, Mode=TwoWay}"
                                                             IsVisible="{Binding IsEditingTitle}"
                                                             VerticalAlignment="Center"
                                                             AutomationProperties.Name="任务标题"
                                                             LostFocus="OnTaskTitleLostFocus">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Enter"
                                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CommitTitleEditCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            <KeyBinding Gesture="Escape"
                                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelTitleEditCommand}"
                                                                        CommandParameter="{Binding}" />
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                </Panel>

                                                <Button Grid.Column="4" Grid.Row="0"
                                                        Classes="IconCircle Compact RowAction"
                                                        Margin="12,0,0,0"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteTaskCommand}"
                                                        CommandParameter="{Binding Task}"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="删除">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Classes="StrokeIcon Muted" Data="{StaticResource IconClose}" />
                                                    </Viewbox>
                                                </Button>

                                                <!-- 元信息行：到期常驻（无值时为「到期」占位），保证改期入口可发现 (design §2.3)。
                                                     选择器左内边距 6px，整体左移 6px 使图标与标题首字对齐。 -->
                                                <StackPanel Grid.Column="3" Grid.Row="1"
                                                            Orientation="Horizontal"
                                                            Spacing="4"
                                                            Margin="-6,4,0,0">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="4"
                                                                IsVisible="{Binding HasProject}">
                                                        <Ellipse Classes="ProjectDot"
                                                                 Margin="6,0,2,0"
                                                                 Fill="{Binding ProjectColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                                        <TextBlock Classes="MetaText" Text="{Binding ProjectName}" />
                                                        <TextBlock Classes="MetaSeparator" Text="·" />
                                                    </StackPanel>

                                                    <!-- 未完成：到期选择器；已完成：完成日（用户原话「显示为 xx/xx已完成」）。
                                                         完成后改期无意义，取消勾选即恢复选择器与原到期日。 -->
                                                    <controls:DueDatePicker Date="{Binding DueDate}"
                                                                            IsVisible="{Binding !IsCompleted}"
                                                                            Editor="{Binding $parent[Window].((vm:MainViewModel)DataContext).RowDueDateEditor}"
                                                                            CommitCommand="{Binding $parent[Window].((vm:MainViewModel)DataContext).CommitRowDueDateCommand}"
                                                                            CommitTarget="{Binding}" />
                                                    <TextBlock Classes="MetaText Done"
                                                               Margin="6,0,0,0"
                                                               IsVisible="{Binding IsCompleted}"
                                                               Text="{Binding CompletedLocalText}" />

                                                    <TextBlock Classes="MetaSeparator" Text="·" />
                                                    <TextBlock Classes="MetaText"
                                                               Text="{Binding CreatedLocalText}"
                                                               ToolTip.Tip="创建日期" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== 视图 B: 外观设置内容 (spec-settings-master-detail-and-theme-presets) ==========
                         选项栏与返回在窗口左侧；此处只渲染当前选中项。 -->
                    <Grid IsVisible="{Binding IsSettingsOpen}">
                        <!-- 留白用内容 Margin 而非 ScrollViewer.Padding，原因同上（Extent 不计 Padding）。 -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="28"
                                        Margin="0,0,12,32">

                                <StackPanel Spacing="28"
                                            IsVisible="{Binding SelectedSettingsSection, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=Appearance}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="外观主题" Classes="FieldLabel" />
                                        <ListBox Classes="ColorChips"
                                                 ItemsSource="{Binding ThemePresets}"
                                                 SelectedItem="{Binding SelectedThemePreset, Mode=TwoWay}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="appearance:ThemePreset">
                                                    <StackPanel Spacing="8">
                                                        <Border Height="52"
                                                                CornerRadius="12"
                                                                ClipToBounds="True"
                                                                Background="{Binding Preview}" />
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Medium"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <StackPanel Spacing="12">
                                        <TextBlock Text="窗口材质" Classes="FieldLabel" />
                                        <ListBox Classes="ColorChips"
                                                 ItemsSource="{Binding MaterialPresets}"
                                                 SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="appearance:MaterialOption">
                                                    <StackPanel Spacing="8">
                                                        <Border Height="52"
                                                                CornerRadius="12"
                                                                ClipToBounds="True"
                                                                Background="{Binding Swatch}" />
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Medium"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="28"
                                            MaxWidth="640"
                                            HorizontalAlignment="Left"
                                            IsVisible="{Binding SelectedSettingsSection, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=General}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="默认到期偏移" Classes="FieldLabel" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <NumericUpDown Grid.Column="0"
                                                           Minimum="1"
                                                           Maximum="30"
                                                           Increment="1"
                                                           Value="{Binding EditingDefaultDueOffsetDays, Mode=TwoWay}" />
                                            <Button Grid.Column="1"
                                                    Classes="PrimaryAction"
                                                    Margin="10,0,0,0"
                                                    Content="保存"
                                                    Command="{Binding SaveDefaultDueOffsetCommand}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="12">
                                        <TextBlock Text="关闭窗口" Classes="FieldLabel" />
                                        <RadioButton GroupName="CloseWindowAction"
                                                     IsChecked="{Binding CloseAction, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=MinimizeToTray, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="最小化到系统托盘"
                                                           VerticalAlignment="Center" />
                                                <Border CornerRadius="4"
                                                        Padding="6,2"
                                                        Background="{DynamicResource AccentSubtleBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="推荐"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="CloseWindowAction"
                                                     Content="彻底退出"
                                                     IsChecked="{Binding CloseAction, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=Exit, Mode=TwoWay}" />
                                    </StackPanel>

                                    <Button Content="彻底退出"
                                            HorizontalAlignment="Left"
                                            Margin="0,12,0,0"
                                            Command="{Binding ExitApplicationCommand}" />
                                </StackPanel>

                                <guide:GuidePage IsVisible="{Binding SelectedSettingsSection, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=Guide}" />

                                <StackPanel Spacing="10"
                                            MaxWidth="640"
                                            HorizontalAlignment="Left"
                                            IsVisible="{Binding SelectedSettingsSection, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=About}">
                                    <TextBlock Text="FlowTask Desktop" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="aisdwf · .NET 8 &amp; Avalonia 11" Classes="CaptionText" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>


        <!-- 未设关闭默认时的选择层（spec-close-to-tray）：不另开 Window，避免再占一条生命周期 -->
        <Grid IsVisible="{Binding IsClosePromptOpen}" ZIndex="110">
            <Button HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding DismissClosePromptCommand}">
                <Button.Template>
                    <ControlTemplate>
                        <Border Background="#73000000" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Classes="SettingsCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="360"
                    Padding="24"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel Spacing="16">
                    <TextBlock Text="关闭窗口" Classes="SectionTitle" />
                    <StackPanel Spacing="8">
                        <RadioButton GroupName="ClosePromptChoice"
                                     Content="最小化到托盘"
                                     IsChecked="{Binding ClosePromptChoice, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=MinimizeToTray, Mode=TwoWay}" />
                        <RadioButton GroupName="ClosePromptChoice"
                                     Content="直接退出"
                                     IsChecked="{Binding ClosePromptChoice, Converter={x:Static conv:EnumChoiceConverter.Instance}, ConverterParameter=Exit, Mode=TwoWay}" />
                    </StackPanel>
                    <CheckBox Content="设为默认"
                              IsChecked="{Binding RememberCloseAction, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Command="{Binding DismissClosePromptCommand}" />
                        <Button Classes="PrimaryAction"
                                Content="确认"
                                Command="{Binding ConfirmClosePromptCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 删除项目确认 (spec-delete-project-cascade-tasks / R-2.7)：级联物理删除不可逆，须先告知将删除多少条任务。
             用户原话（2026-09-29）：「删除项目的表现，目前跳出的位置还是有点违背不突变的原则，感觉可以用弹窗的形式更加合理」。
             此前是任务流上方插入的一行，出现时把整列任务推下去；改为与关闭选择层同构的居中弹层，
             遮罩吸收点击 = 取消。危险操作需要阻断式确认，属 design §2.2 允许的例外（与关闭选择层同理）。 -->
        <Grid IsVisible="{Binding IsDeleteProjectPromptOpen}" ZIndex="105">
            <Button HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding CancelDeleteProjectCommand}">
                <Button.Template>
                    <ControlTemplate>
                        <Border Background="#73000000" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Classes="SettingsCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="360"
                    MaxWidth="440"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Classes="SectionTitle"
                               TextWrapping="Wrap"
                               Text="{Binding ProjectPendingDeletion.Name, StringFormat='删除项目「{0}」？'}" />
                    <TextBlock Classes="BodyText"
                               Text="{Binding ProjectPendingDeletionTaskCount, StringFormat='将删除其下 {0} 条任务，不可撤销。'}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Command="{Binding CancelDeleteProjectCommand}" />
                        <Button Classes="DangerAction"
                                Content="确认删除"
                                Command="{Binding ConfirmDeleteProjectCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 首次聚光灯引导（spec-onboarding-guide，R-6.1）：压在所有业务弹层之上、启动错误条之下 -->
        <onboarding:CoachMarkOverlay DataContext="{Binding Onboarding}" ZIndex="115" />

        <!-- 启动失败可见提示：无控制台，不能只写日志 -->
        <Border IsVisible="{Binding HasInitializationError}"
                ZIndex="120"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="16"
                Padding="16,12"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8">
            <TextBlock Text="{Binding InitializationError}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" />
        </Border>

        <!-- 水波纹转场层 (spec-editorial-and-ripple-theme §2)：位于最顶层，扩散时覆盖全窗 -->
        <Canvas x:Name="RevealCanvas" IsHitTestVisible="False" IsVisible="False" ClipToBounds="True">
            <Ellipse x:Name="RevealCircle" Width="0" Height="0" Opacity="0" RenderTransform="scale(0)" />
        </Canvas>
    </Grid>
</Window>
