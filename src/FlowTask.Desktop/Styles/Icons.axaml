<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      操作图标的唯一几何源。全部为 24×24 描边路径，线宽与端点由 Path.StrokeIcon 统一。
      为什么不用字体字符：☀/☾/⚙/🗑 各自落入不同字体回退，线宽无法对齐。
    -->

    <!--
      顶栏三钮（? | 设置 | 昼夜）的几何（spec-icon-refresh）。
      圆一律写成两段半圆再 Z 闭合：旧版用 "A … 11.99,y" 近似闭合，起止点差 0.01，
      圆头端点在接缝处叠出小鼓包，加粗后尤其显眼（所有者原话「画笔断触的感觉」）。
    -->

    <!-- 太阳：r=4 闭合圆 + 8 根短光芒（r 7→9.5）。光芒短而贴近圆心，加粗后不散 -->
    <StreamGeometry x:Key="IconSun">M8,12 A4,4 0 1 0 16,12 A4,4 0 1 0 8,12 Z M19,12 L21.5,12 M16.95,16.95 L18.72,18.72 M12,19 L12,21.5 M7.05,16.95 L5.28,18.72 M5,12 L2.5,12 M7.05,7.05 L5.28,5.28 M12,5 L12,2.5 M16.95,7.05 L18.72,5.28</StreamGeometry>

    <!-- 月亮：外弧 r=9、内弧 r=6.5 的单条闭合月牙，没有接缝 -->
    <StreamGeometry x:Key="IconMoon">M12,3 A6.5,6.5 0 0 0 21,12 A9,9 0 1 1 12,3 Z</StreamGeometry>

    <!-- 齿轮：6 齿，齿顶直线、齿间沿 r=7 根圆弧，外廓单条闭合路径 + r=3 轴孔。
         旧版是 8 叶花瓣式几十段小弧，缩到 18–20px 发糊，与其余直线 + 大弧的几何语言不一致 -->
    <StreamGeometry x:Key="IconSettings">M9.84,5.34 L10.02,2.71 L13.98,2.71 L14.16,5.34 A7,7 0 0 1 16.68,6.8 L19.06,5.64 L21.04,9.06 L18.85,10.54 A7,7 0 0 1 18.85,13.46 L21.04,14.94 L19.06,18.36 L16.68,17.2 A7,7 0 0 1 14.16,18.66 L13.98,21.29 L10.02,21.29 L9.84,18.66 A7,7 0 0 1 7.32,17.2 L4.94,18.36 L2.96,14.94 L5.15,13.46 A7,7 0 0 1 5.15,10.54 L2.96,9.06 L4.94,5.64 L7.32,6.8 A7,7 0 0 1 9.84,5.34 Z M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12 Z</StreamGeometry>

    <StreamGeometry x:Key="IconArrowLeft">M19,12 L5,12 M12,19 L5,12 L12,5</StreamGeometry>

    <StreamGeometry x:Key="IconTrash">M4,7 L20,7 M9,7 L9,4.5 A1,1 0 0 1 10,3.5 L14,3.5 A1,1 0 0 1 15,4.5 L15,7 M6.5,7 L7.4,19.2 A1.5,1.5 0 0 0 8.9,20.5 L15.1,20.5 A1.5,1.5 0 0 0 16.6,19.2 L17.5,7 M10,11 L10,16.5 M14,11 L14,16.5</StreamGeometry>

    <StreamGeometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>

    <StreamGeometry x:Key="IconPlus">M12,5 L12,19 M5,12 L19,12</StreamGeometry>

    <StreamGeometry x:Key="IconSpark">M12,3 L13.6,8.6 L19.2,10.2 L13.6,11.8 L12,17.4 L10.4,11.8 L4.8,10.2 L10.4,8.6 Z</StreamGeometry>

    <StreamGeometry x:Key="IconCheck">M5,12.5 L10,17.5 L19,7</StreamGeometry>

    <!-- 到期日选择器触发入口 (spec-due-date-picker) -->
    <StreamGeometry x:Key="IconCalendar">M5.5,5 L18.5,5 A1.5,1.5 0 0 1 20,6.5 L20,19 A1.5,1.5 0 0 1 18.5,20.5 L5.5,20.5 A1.5,1.5 0 0 1 4,19 L4,6.5 A1.5,1.5 0 0 1 5.5,5 Z M4,10 L20,10 M8,3 L8,7 M16,3 L16,7</StreamGeometry>

    <!-- 操作指南入口（spec-onboarding-guide）：圆 + 问号，与齿轮同一描边规格。
         外圆同样改为两段半圆闭合（spec-icon-refresh），问号笔画不变 -->
    <StreamGeometry x:Key="IconHelp">M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M9.2,9.3 A2.9,2.9 0 0 1 14.8,10.1 C14.8,12 12,12.4 12,14.4 M12,17.4 L12,17.5</StreamGeometry>

    <!--
      行内操作几何（spec-icon-refresh 定稿，由 spec-task-pin / spec-project-archive 引用）。
      行内沿用 1.75 描边，与垃圾桶、关闭同一重量。
    -->

    <!-- 置顶：图钉。帽沿 + 梯形钉身 + 钉尖 -->
    <StreamGeometry x:Key="IconPin">M9,3.5 L15,3.5 M10,3.5 L10,9 L6.5,13.5 L17.5,13.5 L14,9 L14,3.5 M12,13.5 L12,20.5</StreamGeometry>

    <!-- 归档：盒盖 + 盒身 + 提手横线 -->
    <StreamGeometry x:Key="IconArchive">M3.5,4.5 L20.5,4.5 L20.5,8.5 L3.5,8.5 Z M5,8.5 L5,18.5 A1.5,1.5 0 0 0 6.5,20 L17.5,20 A1.5,1.5 0 0 0 19,18.5 L19,8.5 M10,12.5 L14,12.5</StreamGeometry>

    <!-- 恢复：与归档同一盒体，提手换成向上箭头，表示「取回」 -->
    <StreamGeometry x:Key="IconRestore">M3.5,4.5 L20.5,4.5 L20.5,8.5 L3.5,8.5 Z M5,8.5 L5,18.5 A1.5,1.5 0 0 0 6.5,20 L17.5,20 A1.5,1.5 0 0 0 19,18.5 L19,8.5 M12,17 L12,11.5 M9.5,14 L12,11.5 L14.5,14</StreamGeometry>

    <!-- 演示场景里的鼠标指针：唯一的填充几何，只在引导动效中出现，不作操作图标 -->
    <StreamGeometry x:Key="GuidePointer">M0,0 L0,15 L4,11.4 L6.8,17.6 L9.2,16.6 L6.5,10.5 L11.6,10.5 Z</StreamGeometry>

</ResourceDictionary>
