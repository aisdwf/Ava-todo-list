[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
publish/

[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio / Rider cache & temp files
.vs/
.idea/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.ide
*.sw?

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Avalonia temp
GeneratedArtifacts/

# AI Workflow methodology (private; deep rationale, not required to operate the repo)
# AGENTS.md + docs/rules/ + docs/specs/ remain tracked so the working memory ships with the repo.
docs/ai-workflow/

# 设计参考素材（内部协同资产，与 docs/ 同属私有）
# res/ 下为视觉参考图，是 DESIGN-0002 的设计来源，不随源码公开
res/



# CodeGraph local index (machine-local; do not ship)
.codegraph/
